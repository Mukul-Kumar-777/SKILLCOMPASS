<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#050d20" />
  <meta
    name="description"
    content="SkillCompass — AI career intelligence that turns the work you build into clearer career opportunities."
  />
  <title>SkillCompass — AI Career Intelligence</title>

  <style>
    :root {
      --sc-bg: #050d20;
      --sc-bg-deep: #030918;
      --sc-panel: rgba(15, 34, 68, 0.66);
      --sc-panel-strong: rgba(17, 40, 78, 0.84);
      --sc-line: rgba(112, 176, 255, 0.18);
      --sc-white: #f6f9ff;
      --sc-copy: #c6ddf5;
      --sc-muted: #8ea8ca;
      --sc-dim: #6883ab;
      --sc-blue: #63b7ff;
      --sc-cyan: #62e8ff;
      --sc-purple: #c39aff;
      --sc-mint: #61e6b4;
      --sc-amber: #ffd178;
      --sc-radius-xl: 30px;
      --sc-radius-lg: 22px;
      --sc-shadow:
        18px 20px 50px rgba(0, 0, 0, 0.34),
        -10px -10px 26px rgba(73, 143, 225, 0.035),
        inset 1px 1px 0 rgba(255, 255, 255, 0.04),
        inset -1px -1px 0 rgba(0, 0, 0, 0.22);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-width: 320px;
      min-height: 100vh;
      overflow-x: hidden;
      font-family:
        Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
        "Segoe UI", sans-serif;
      color: var(--sc-white);
      background:
        radial-gradient(circle at 79% 20%, rgba(61, 123, 226, 0.12), transparent 27%),
        radial-gradient(circle at 19% 74%, rgba(89, 64, 181, 0.10), transparent 24%),
        linear-gradient(150deg, var(--sc-bg-deep), var(--sc-bg) 42%, #07132c);
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -4;
      pointer-events: none;
      background:
        radial-gradient(circle at 50% 13%, rgba(98, 232, 255, 0.08), transparent 23%),
        radial-gradient(circle at 68% 61%, rgba(195, 154, 255, 0.07), transparent 25%);
    }

    body::after {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -3;
      pointer-events: none;
      opacity: 0.27;
      background-image:
        linear-gradient(rgba(255,255,255,0.014) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.014) 1px, transparent 1px);
      background-size: 44px 44px;
      mask-image: linear-gradient(to bottom, rgba(0,0,0,0.9), transparent 82%);
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    .sc-page {
      position: relative;
      min-height: 100vh;
      isolation: isolate;
    }

    .sc-noise,
    .sc-stars {
      position: fixed;
      inset: 0;
      z-index: -2;
      pointer-events: none;
    }

    .sc-noise {
      opacity: 0.03;
      background-image:
        radial-gradient(rgba(255,255,255,0.8) 0.6px, transparent 0.7px);
      background-size: 5px 5px;
      mix-blend-mode: screen;
    }

    .sc-stars {
      overflow: hidden;
    }

    .sc-star {
      position: absolute;
      width: 2px;
      height: 2px;
      border-radius: 50%;
      background: rgba(171, 225, 255, 0.72);
      box-shadow: 0 0 8px rgba(98, 232, 255, 0.65);
      animation: sc-twinkle var(--duration) ease-in-out infinite;
      animation-delay: var(--delay);
    }

    @keyframes sc-twinkle {
      0%, 100% {
        opacity: 0.18;
        transform: scale(0.75);
      }
      50% {
        opacity: 0.95;
        transform: scale(1.18);
      }
    }

    .sc-container {
      width: min(1420px, calc(100% - 56px));
      margin: 0 auto;
    }

    .sc-header {
      position: relative;
      z-index: 10;
      padding: 22px 0 0;
    }

    .sc-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 70px;
      padding: 10px 13px 10px 18px;
      border: 1px solid var(--sc-line);
      border-radius: 22px;
      background:
        linear-gradient(145deg, rgba(20, 47, 90, 0.72), rgba(8, 26, 55, 0.78));
      box-shadow: var(--sc-shadow);
      backdrop-filter: blur(18px);
    }

    .sc-brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
      font-size: 19px;
      font-weight: 850;
      letter-spacing: -0.03em;
    }

    .sc-brand-mark {
      position: relative;
      display: grid;
      place-items: center;
      width: 38px;
      height: 38px;
      border: 1px solid rgba(98, 232, 255, 0.44);
      border-radius: 50%;
      background: linear-gradient(145deg, rgba(28, 88, 153, 0.7), rgba(19, 40, 85, 0.75));
      box-shadow:
        0 0 18px rgba(98, 232, 255, 0.18),
        inset 1px 1px 7px rgba(255, 255, 255, 0.08);
    }

    .sc-brand-mark::before,
    .sc-brand-mark::after {
      content: "";
      position: absolute;
      border-radius: 50%;
    }

    .sc-brand-mark::before {
      width: 16px;
      height: 16px;
      border: 1px solid rgba(98, 232, 255, 0.9);
      transform: rotate(25deg);
    }

    .sc-brand-mark::after {
      width: 3px;
      height: 22px;
      border-radius: 6px;
      background: linear-gradient(to bottom, var(--sc-cyan), var(--sc-purple));
      transform: rotate(45deg);
      box-shadow: 0 0 8px rgba(98, 232, 255, 0.68);
    }

    .sc-brand-text {
      background: linear-gradient(100deg, #f5f8ff 15%, #8cecff 60%, #be9aff 93%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .sc-nav-links {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-left: auto;
      margin-right: 12px;
    }

    .sc-nav-link {
      padding: 10px 13px;
      border-radius: 12px;
      color: var(--sc-copy);
      font-size: 13px;
      font-weight: 750;
      transition:
        color 180ms ease,
        background 180ms ease,
        transform 180ms ease;
    }

    .sc-nav-link:hover {
      color: var(--sc-white);
      background: rgba(99, 183, 255, 0.09);
      transform: translateY(-1px);
    }

    .sc-nav-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .sc-status {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 38px;
      padding: 0 13px;
      border: 1px solid rgba(97, 230, 180, 0.22);
      border-radius: 999px;
      background: rgba(8, 31, 52, 0.62);
      color: #dffef1;
      font-size: 11px;
      font-weight: 850;
      letter-spacing: 0.08em;
      white-space: nowrap;
    }

    .sc-status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--sc-mint);
      box-shadow:
        0 0 10px rgba(97, 230, 180, 0.95),
        0 0 20px rgba(97, 230, 180, 0.32);
      animation: sc-pulse 1.9s ease-in-out infinite;
    }

    @keyframes sc-pulse {
      0%, 100% { transform: scale(0.88); opacity: 0.68; }
      50% { transform: scale(1.08); opacity: 1; }
    }

    .sc-nav-cta {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      min-height: 42px;
      padding: 0 16px;
      border: 1px solid rgba(99, 183, 255, 0.33);
      border-radius: 13px;
      background: linear-gradient(135deg, #2f8cff, #6d74ff 55%, #9766e8);
      color: #ffffff;
      font-size: 12px;
      font-weight: 850;
      box-shadow:
        0 12px 26px rgba(36, 105, 212, 0.23),
        inset 1px 1px 0 rgba(255, 255, 255, 0.15);
      transition:
        transform 180ms ease,
        box-shadow 180ms ease;
    }

    .sc-nav-cta:hover {
      transform: translateY(-2px);
      box-shadow:
        0 16px 30px rgba(36, 105, 212, 0.32),
        0 0 18px rgba(98, 232, 255, 0.1);
    }

    .sc-github-mark {
      display: grid;
      place-items: center;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: rgba(3, 12, 28, 0.52);
      font-size: 12px;
      font-weight: 900;
    }

    .sc-hero {
      position: relative;
      min-height: 760px;
      padding: 92px 0 42px;
      display: grid;
      grid-template-columns: minmax(0, 0.92fr) minmax(560px, 1.08fr);
      align-items: center;
      gap: 28px;
    }

    .sc-hero-copy {
      position: relative;
      z-index: 3;
      max-width: 690px;
    }

    .sc-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 34px;
      padding: 0 12px;
      border: 1px solid rgba(98, 232, 255, 0.17);
      border-radius: 999px;
      background: rgba(20, 55, 95, 0.36);
      color: #8feeff;
      font-size: 11px;
      font-weight: 850;
      letter-spacing: 0.1em;
      box-shadow:
        inset 1px 1px 0 rgba(255, 255, 255, 0.04),
        0 0 20px rgba(98, 232, 255, 0.05);
    }

    .sc-eyebrow-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--sc-cyan), var(--sc-purple));
      box-shadow: 0 0 12px rgba(98, 232, 255, 0.55);
    }

    .sc-title {
      margin: 22px 0 18px;
      max-width: 780px;
      font-size: clamp(58px, 6.2vw, 102px);
      line-height: 0.96;
      letter-spacing: -0.065em;
      font-weight: 900;
      text-wrap: balance;
    }

    .sc-title .white {
      display: block;
      color: var(--sc-white);
    }

    .sc-title .gradient {
      display: inline-block;
      background:
        linear-gradient(
          103deg,
          #8acfff 0%,
          #4ddfff 30%,
          #75a3ff 56%,
          #c39aff 83%,
          #e0b4ff 100%
        );
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      filter: drop-shadow(0 0 24px rgba(99, 183, 255, 0.10));
    }

    .sc-hero-copy > p {
      max-width: 650px;
      margin: 0;
      color: var(--sc-copy);
      font-size: 17px;
      line-height: 1.72;
      font-weight: 520;
    }

    .sc-hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      margin-top: 32px;
    }

    .sc-primary,
    .sc-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 52px;
      padding: 0 19px;
      border-radius: 16px;
      font-size: 13px;
      font-weight: 850;
      transition:
        transform 180ms ease,
        box-shadow 180ms ease,
        border-color 180ms ease,
        background 180ms ease;
    }

    .sc-primary {
      border: 1px solid rgba(138, 210, 255, 0.3);
      background: linear-gradient(135deg, #2f8cff, #756dff 56%, #9a67e7);
      box-shadow:
        0 17px 34px rgba(35, 100, 208, 0.25),
        inset 1px 1px 0 rgba(255,255,255,0.17);
      color: #fff;
    }

    .sc-primary:hover {
      transform: translateY(-2px);
      box-shadow:
        0 21px 39px rgba(35, 100, 208, 0.32),
        0 0 25px rgba(98, 232, 255, 0.08);
    }

    .sc-secondary {
      border: 1px solid rgba(116, 175, 232, 0.24);
      background: rgba(14, 35, 70, 0.44);
      box-shadow:
        inset 1px 1px 0 rgba(255,255,255,0.035),
        0 15px 28px rgba(0,0,0,0.18);
      color: var(--sc-white);
    }

    .sc-secondary:hover {
      transform: translateY(-2px);
      border-color: rgba(98, 232, 255, 0.32);
      background: rgba(19, 46, 86, 0.58);
    }

    .sc-arrow {
      font-size: 18px;
      line-height: 1;
      transition: transform 180ms ease;
    }

    .sc-primary:hover .sc-arrow,
    .sc-secondary:hover .sc-arrow {
      transform: translateX(3px);
    }

    .sc-hero-note {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 23px;
      color: var(--sc-muted);
      font-size: 12px;
      font-weight: 650;
    }

    .sc-hero-note strong {
      color: var(--sc-copy);
      font-weight: 850;
    }

    .sc-hero-note-line {
      width: 28px;
      height: 1px;
      background: linear-gradient(90deg, rgba(98,232,255,0.62), transparent);
    }

    .sc-visual {
      position: relative;
      z-index: 2;
      min-height: 650px;
      display: grid;
      place-items: center;
    }

    .sc-visual::before {
      content: "";
      position: absolute;
      width: 650px;
      height: 650px;
      border-radius: 50%;
      background:
        radial-gradient(
          circle,
          rgba(44, 126, 237, 0.22) 0%,
          rgba(86, 107, 255, 0.11) 34%,
          rgba(195, 154, 255, 0.05) 52%,
          transparent 72%
        );
      filter: blur(13px);
      animation: sc-halo 7s ease-in-out infinite;
    }

    @keyframes sc-halo {
      0%, 100% {
        transform: scale(0.96);
        opacity: 0.74;
      }
      50% {
        transform: scale(1.04);
        opacity: 1;
      }
    }

    .sc-orbit {
      position: absolute;
      border: 1px solid rgba(109, 207, 255, 0.16);
      border-radius: 50%;
      transform: rotate(-17deg);
      box-shadow: 0 0 22px rgba(98, 232, 255, 0.04);
    }

    .sc-orbit.one {
      width: 610px;
      height: 235px;
      animation: sc-orbit 10s linear infinite;
    }

    .sc-orbit.two {
      width: 540px;
      height: 205px;
      transform: rotate(63deg) scaleY(0.9);
      border-color: rgba(195, 154, 255, 0.12);
      animation: sc-orbit-reverse 13s linear infinite;
    }

    .sc-orbit.three {
      width: 700px;
      height: 320px;
      transform: rotate(17deg);
      border-color: rgba(99, 183, 255, 0.08);
      animation: sc-orbit 18s linear infinite;
    }

    @keyframes sc-orbit {
      from { transform: rotate(-17deg); }
      to { transform: rotate(343deg); }
    }

    @keyframes sc-orbit-reverse {
      from { transform: rotate(63deg) scaleY(0.9); }
      to { transform: rotate(-297deg) scaleY(0.9); }
    }

    .sc-orb {
      position: relative;
      width: min(455px, 72vw);
      aspect-ratio: 1;
      border-radius: 47% 53% 51% 49% / 52% 45% 55% 48%;
      transform: rotate(-12deg);
      background:
        radial-gradient(circle at 30% 25%, rgba(235,253,255,0.98), transparent 8%),
        radial-gradient(circle at 64% 29%, rgba(71, 218, 255, 0.88), transparent 18%),
        radial-gradient(circle at 31% 73%, rgba(84, 119, 255, 0.95), transparent 21%),
        radial-gradient(circle at 70% 63%, rgba(180, 122, 255, 0.83), transparent 17%),
        radial-gradient(circle at 52% 51%, rgba(7, 21, 50, 0.4), transparent 38%),
        conic-gradient(
          from 28deg,
          #0b1c48,
          #29d9ff 14%,
          #214ee8 29%,
          #09163b 42%,
          #8d6bff 57%,
          #173ce0 71%,
          #0a173a 84%,
          #56e7ff 96%,
          #0b1c48
        );
      box-shadow:
        0 28px 68px rgba(0,0,0,0.48),
        0 0 42px rgba(72, 171, 255, 0.19),
        inset 18px 15px 28px rgba(255,255,255,0.08),
        inset -22px -26px 42px rgba(0,0,0,0.33);
      animation: sc-float 6.4s ease-in-out infinite;
    }

    @keyframes sc-float {
      0%, 100% {
        transform: rotate(-12deg) translate3d(0, 0, 0) scale(1);
      }
      50% {
        transform: rotate(-9deg) translate3d(0, -10px, 0) scale(1.018);
      }
    }

    .sc-orb::before {
      content: "";
      position: absolute;
      inset: 11%;
      border-radius: inherit;
      background:
        conic-gradient(
          from 220deg,
          transparent 0deg,
          rgba(119, 234, 255, 0.55) 26deg,
          transparent 56deg,
          rgba(195, 154, 255, 0.45) 93deg,
          transparent 137deg,
          rgba(98, 232, 255, 0.48) 185deg,
          transparent 225deg,
          rgba(110, 132, 255, 0.44) 288deg,
          transparent 328deg
        );
      filter: blur(3px);
      mix-blend-mode: screen;
      animation: sc-liquid 8s linear infinite;
    }

    @keyframes sc-liquid {
      to { transform: rotate(360deg); }
    }

    .sc-orb::after {
      content: "";
      position: absolute;
      inset: 13%;
      border-radius: 44% 56% 54% 46% / 48% 48% 52% 52%;
      background:
        radial-gradient(circle at 37% 29%, rgba(255,255,255,0.38), transparent 7%),
        radial-gradient(circle at 75% 52%, rgba(255,255,255,0.14), transparent 14%),
        linear-gradient(145deg, rgba(255,255,255,0.10), transparent 36% 64%, rgba(2,9,25,0.36));
      filter: blur(1px);
      opacity: 0.9;
    }

    .sc-orb-core {
      position: absolute;
      inset: 28%;
      z-index: 2;
      display: grid;
      place-items: center;
      border: 1px solid rgba(182, 237, 255, 0.22);
      border-radius: 38%;
      background:
        radial-gradient(circle at 35% 28%, rgba(255,255,255,0.22), transparent 15%),
        linear-gradient(145deg, rgba(17,52,105,0.34), rgba(5,14,36,0.44));
      box-shadow:
        0 0 32px rgba(98,232,255,0.14),
        inset 1px 1px 0 rgba(255,255,255,0.06);
      backdrop-filter: blur(8px);
    }

    .sc-orb-core::before {
      content: "";
      width: 112px;
      height: 112px;
      border: 1px solid rgba(98,232,255,0.38);
      border-radius: 50%;
      box-shadow:
        0 0 20px rgba(98,232,255,0.15),
        inset 0 0 18px rgba(98,232,255,0.06);
    }

    .sc-orb-core-label {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      text-align: center;
      pointer-events: none;
    }

    .sc-orb-core-label strong {
      font-size: 18px;
      font-weight: 900;
      letter-spacing: -0.04em;
      color: #ffffff;
    }

    .sc-orb-core-label small {
      color: #99edff;
      font-size: 10px;
      font-weight: 850;
      letter-spacing: 0.11em;
    }

    .sc-chip {
      position: absolute;
      z-index: 4;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      min-height: 36px;
      padding: 0 11px;
      border: 1px solid rgba(118, 183, 238, 0.19);
      border-radius: 999px;
      background: rgba(11, 31, 64, 0.65);
      color: var(--sc-copy);
      font-size: 11px;
      font-weight: 800;
      box-shadow:
        0 14px 28px rgba(0,0,0,0.25),
        inset 1px 1px 0 rgba(255,255,255,0.04);
      backdrop-filter: blur(10px);
      animation: sc-chip-float 5s ease-in-out infinite;
    }

    .sc-chip::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--sc-cyan), var(--sc-purple));
      box-shadow: 0 0 9px rgba(98,232,255,0.52);
    }

    .sc-chip.one {
      top: 17%;
      right: 15%;
      --shift: 7px;
    }

    .sc-chip.two {
      top: 33%;
      right: 3%;
      --shift: -7px;
      animation-delay: -1.2s;
    }

    .sc-chip.three {
      bottom: 27%;
      right: 8%;
      --shift: 8px;
      animation-delay: -2.1s;
    }

    .sc-chip.four {
      bottom: 17%;
      left: 10%;
      --shift: -6px;
      animation-delay: -0.8s;
    }

    .sc-chip.five {
      top: 28%;
      left: 7%;
      --shift: 7px;
      animation-delay: -2.8s;
    }

    .sc-chip.six {
      top: 58%;
      left: 2%;
      --shift: -8px;
      animation-delay: -3.8s;
    }

    @keyframes sc-chip-float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(var(--shift)); }
    }

    .sc-orb-caption {
      position: absolute;
      z-index: 5;
      right: 6%;
      bottom: 8%;
      width: 205px;
      padding: 17px;
      border: 1px solid rgba(117, 178, 233, 0.18);
      border-radius: 18px;
      background: linear-gradient(145deg, rgba(18, 45, 83, 0.72), rgba(8, 25, 53, 0.74));
      box-shadow:
        20px 24px 45px rgba(0,0,0,0.26),
        inset 1px 1px 0 rgba(255,255,255,0.035);
      backdrop-filter: blur(12px);
    }

    .sc-orb-caption-kicker {
      margin: 0 0 6px;
      color: #8cecff;
      font-size: 10px;
      font-weight: 850;
      letter-spacing: 0.1em;
    }

    .sc-orb-caption-title {
      margin: 0;
      color: var(--sc-white);
      font-size: 17px;
      line-height: 1.16;
      font-weight: 900;
      letter-spacing: -0.03em;
    }

    .sc-orb-caption-copy {
      margin: 8px 0 0;
      color: var(--sc-muted);
      font-size: 11px;
      line-height: 1.5;
      font-weight: 650;
    }

    .sc-orb-caption-bar {
      position: relative;
      height: 5px;
      margin-top: 13px;
      overflow: hidden;
      border-radius: 999px;
      background: rgba(118, 165, 210, 0.11);
    }

    .sc-orb-caption-bar::after {
      content: "";
      position: absolute;
      inset: 0 34% 0 0;
      border-radius: inherit;
      background: linear-gradient(90deg, var(--sc-cyan), var(--sc-purple));
      box-shadow: 0 0 11px rgba(98,232,255,0.3);
    }

    .sc-stats {
      position: relative;
      z-index: 3;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 13px;
      margin-top: -5px;
      padding-bottom: 18px;
    }

    .sc-stat {
      min-height: 112px;
      padding: 20px 18px;
      border: 1px solid var(--sc-line);
      border-radius: 20px;
      background:
        linear-gradient(145deg, rgba(18, 44, 82, 0.61), rgba(8, 27, 58, 0.69));
      box-shadow: var(--sc-shadow);
      backdrop-filter: blur(14px);
    }

    .sc-stat-value {
      margin: 0;
      font-size: 27px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: -0.04em;
    }

    .sc-stat-label {
      margin: 9px 0 0;
      color: var(--sc-muted);
      font-size: 11px;
      font-weight: 750;
    }

    .sc-stat-accent {
      display: block;
      width: 34px;
      height: 2px;
      margin-top: 15px;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--sc-cyan), transparent);
      box-shadow: 0 0 10px rgba(98,232,255,0.2);
    }

    .sc-explore {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      padding: 13px 0 30px;
      color: var(--sc-dim);
      font-size: 11px;
      font-weight: 750;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .sc-explore-arrow {
      display: grid;
      place-items: center;
      width: 24px;
      height: 24px;
      border: 1px solid rgba(110, 176, 237, 0.18);
      border-radius: 50%;
      animation: sc-bounce 1.9s ease-in-out infinite;
    }

    @keyframes sc-bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(4px); }
    }

    .sc-mobile-menu {
      display: none;
      width: 40px;
      height: 40px;
      border: 1px solid rgba(112,176,255,0.18);
      border-radius: 12px;
      background: rgba(14, 35, 70, 0.56);
      color: var(--sc-white);
      cursor: pointer;
    }

    .sc-mobile-menu span,
    .sc-mobile-menu::before,
    .sc-mobile-menu::after {
      content: "";
      display: block;
      width: 16px;
      height: 2px;
      margin: 3px auto;
      border-radius: 99px;
      background: currentColor;
    }

    @media (max-width: 1180px) {
      .sc-container {
        width: min(100% - 36px, 1100px);
      }

      .sc-nav-links {
        gap: 0;
      }

      .sc-nav-link {
        padding-inline: 9px;
        font-size: 12px;
      }

      .sc-hero {
        grid-template-columns: minmax(0, 0.9fr) minmax(470px, 1.1fr);
        gap: 12px;
        padding-top: 70px;
      }

      .sc-orb {
        width: min(410px, 58vw);
      }

      .sc-orbit.one {
        width: 560px;
      }

      .sc-orbit.two {
        width: 490px;
      }

      .sc-orbit.three {
        width: 620px;
      }
    }

    @media (max-width: 960px) {
      .sc-nav-links,
      .sc-status {
        display: none;
      }

      .sc-mobile-menu {
        display: block;
      }

      .sc-nav-actions {
        margin-left: auto;
      }

      .sc-hero {
        min-height: auto;
        padding-top: 65px;
        grid-template-columns: 1fr;
      }

      .sc-hero-copy {
        max-width: 800px;
      }

      .sc-title {
        font-size: clamp(56px, 10vw, 86px);
      }

      .sc-visual {
        min-height: 570px;
        margin-top: 10px;
      }

      .sc-stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin-top: 5px;
      }
    }

    @media (max-width: 640px) {
      .sc-container {
        width: min(100% - 24px, 600px);
      }

      .sc-header {
        padding-top: 12px;
      }

      .sc-nav {
        min-height: 62px;
        padding: 8px 8px 8px 12px;
        border-radius: 18px;
      }

      .sc-brand-mark {
        width: 34px;
        height: 34px;
      }

      .sc-brand {
        font-size: 17px;
      }

      .sc-nav-cta {
        min-height: 38px;
        padding: 0 12px;
        font-size: 11px;
      }

      .sc-nav-cta span:last-child {
        display: none;
      }

      .sc-hero {
        padding-top: 48px;
      }

      .sc-title {
        font-size: clamp(47px, 14vw, 70px);
        line-height: 0.98;
      }

      .sc-hero-copy > p {
        font-size: 14px;
        line-height: 1.65;
      }

      .sc-eyebrow {
        font-size: 9px;
      }

      .sc-hero-actions {
        flex-direction: column;
        align-items: stretch;
      }

      .sc-primary,
      .sc-secondary {
        width: 100%;
      }

      .sc-hero-note {
        font-size: 10px;
        line-height: 1.45;
      }

      .sc-visual {
        min-height: 430px;
        margin-top: 15px;
      }

      .sc-orb {
        width: min(330px, 74vw);
      }

      .sc-orbit.one {
        width: 390px;
        height: 160px;
      }

      .sc-orbit.two {
        width: 350px;
        height: 145px;
      }

      .sc-orbit.three {
        width: 430px;
        height: 205px;
      }

      .sc-chip {
        min-height: 31px;
        padding: 0 9px;
        font-size: 9px;
      }

      .sc-chip.one { top: 11%; right: 7%; }
      .sc-chip.two { top: 28%; right: -1%; }
      .sc-chip.three { bottom: 21%; right: 3%; }
      .sc-chip.four { bottom: 11%; left: 3%; }
      .sc-chip.five { top: 22%; left: 2%; }
      .sc-chip.six { top: 53%; left: -2%; }

      .sc-orb-caption {
        right: 0;
        bottom: 2%;
        width: 175px;
        padding: 13px;
      }

      .sc-orb-caption-title {
        font-size: 14px;
      }

      .sc-stats {
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .sc-stat {
        min-height: 96px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
      }
    }
  </style>
</head>

<body>
  <div class="sc-page">
    <div class="sc-noise" aria-hidden="true"></div>

    <div class="sc-stars" aria-hidden="true">
      <span class="sc-star" style="left:7%;top:18%;--duration:3.8s;--delay:-1.4s;"></span>
      <span class="sc-star" style="left:15%;top:35%;--duration:4.6s;--delay:-3.1s;"></span>
      <span class="sc-star" style="left:23%;top:12%;--duration:3.2s;--delay:-1.1s;"></span>
      <span class="sc-star" style="left:32%;top:26%;--duration:5.2s;--delay:-4s;"></span>
      <span class="sc-star" style="left:42%;top:9%;--duration:4.1s;--delay:-2.4s;"></span>
      <span class="sc-star" style="left:48%;top:31%;--duration:5.1s;--delay:-1.6s;"></span>
      <span class="sc-star" style="left:59%;top:15%;--duration:3.4s;--delay:-2s;"></span>
      <span class="sc-star" style="left:68%;top:7%;--duration:4.8s;--delay:-0.8s;"></span>
      <span class="sc-star" style="left:77%;top:25%;--duration:4.1s;--delay:-3.6s;"></span>
      <span class="sc-star" style="left:86%;top:11%;--duration:3.3s;--delay:-1.9s;"></span>
      <span class="sc-star" style="left:93%;top:34%;--duration:5.3s;--delay:-2.2s;"></span>
      <span class="sc-star" style="left:11%;top:71%;--duration:5.1s;--delay:-0.6s;"></span>
      <span class="sc-star" style="left:27%;top:82%;--duration:4.3s;--delay:-2.7s;"></span>
      <span class="sc-star" style="left:42%;top:76%;--duration:3.8s;--delay:-3.2s;"></span>
      <span class="sc-star" style="left:58%;top:86%;--duration:5.6s;--delay:-0.9s;"></span>
      <span class="sc-star" style="left:72%;top:72%;--duration:3.9s;--delay:-2.4s;"></span>
      <span class="sc-star" style="left:89%;top:78%;--duration:4.7s;--delay:-1.3s;"></span>
    </div>

    <header class="sc-header">
      <div class="sc-container">
        <nav class="sc-nav" aria-label="Primary navigation">
          <a class="sc-brand" href="/" aria-label="SkillCompass home">
            <span class="sc-brand-mark" aria-hidden="true"></span>
            <span class="sc-brand-text">SkillCompass</span>
          </a>

          <div class="sc-nav-links">
            <a class="sc-nav-link" href="#features">Features</a>
            <a class="sc-nav-link" href="#how-it-works">How it works</a>
            <a class="sc-nav-link" href="#why-skillcompass">Why SkillCompass</a>
            <a class="sc-nav-link" href="#stats">Insights</a>
            <a class="sc-nav-link" href="/api/auth/login">Login</a>
          </div>

          <div class="sc-nav-actions">
            <span class="sc-status">
              <span class="sc-status-dot" aria-hidden="true"></span>
              SYSTEM ONLINE
            </span>

            <a class="sc-nav-cta" href="/api/auth/register">
              <span class="sc-github-mark" aria-hidden="true">↗</span>
              <span>Get Started</span>
            </a>

            <button class="sc-mobile-menu" type="button" aria-label="Open navigation menu" aria-expanded="false">
              <span></span>
            </button>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <section class="sc-container sc-hero" aria-labelledby="hero-title">
        <div class="sc-hero-copy">
          <div class="sc-eyebrow">
            <span class="sc-eyebrow-dot" aria-hidden="true"></span>
            AI CAREER INTELLIGENCE
          </div>

          <h1 class="sc-title" id="hero-title">
            <span class="white">Your code.</span>
            <span class="gradient">Your capability.</span>
          </h1>

          <p>
            SkillCompass reads the work you have actually built, extracts the
            skills you demonstrate, estimates your proficiency, and maps your
            profile to relevant opportunities.
          </p>

          <div class="sc-hero-actions">
            <a class="sc-primary" href="/api/auth/register">
              Analyze my GitHub
              <span class="sc-arrow" aria-hidden="true">→</span>
            </a>

            <a class="sc-secondary" href="#how-it-works">
              Explore the journey
              <span class="sc-arrow" aria-hidden="true">↘</span>
            </a>
          </div>

          <div class="sc-hero-note">
            <span class="sc-hero-note-line" aria-hidden="true"></span>
            <span>From <strong>raw code signals</strong> to clearer career direction.</span>
          </div>
        </div>

        <div class="sc-visual" aria-label="SkillCompass capability visual">
          <div class="sc-orbit one" aria-hidden="true"></div>
          <div class="sc-orbit two" aria-hidden="true"></div>
          <div class="sc-orbit three" aria-hidden="true"></div>

          <div class="sc-chip one">React</div>
          <div class="sc-chip two">TypeScript</div>
          <div class="sc-chip three">APIs</div>
          <div class="sc-chip four">Python</div>
          <div class="sc-chip five">Node.js</div>
          <div class="sc-chip six">Machine Learning</div>

          <div class="sc-orb">
            <div class="sc-orb-core">
              <div class="sc-orb-core-label">
                <strong>You</strong>
                <small>CAPABILITY</small>
              </div>
            </div>
          </div>

          <div class="sc-orb-caption">
            <p class="sc-orb-caption-kicker">THE SKILLCOMPASS LOOP</p>
            <p class="sc-orb-caption-title">Skills become opportunities.</p>
            <p class="sc-orb-caption-copy">
              Real signals. Real evidence. A clearer path forward.
            </p>
            <div class="sc-orb-caption-bar" aria-hidden="true"></div>
          </div>
        </div>
      </section>

      <section class="sc-container sc-stats" id="stats" aria-label="Platform highlights">
        <article class="sc-stat">
          <p class="sc-stat-value">100K+</p>
          <p class="sc-stat-label">Developer profiles envisioned</p>
          <span class="sc-stat-accent" aria-hidden="true"></span>
        </article>

        <article class="sc-stat">
          <p class="sc-stat-value">1M+</p>
          <p class="sc-stat-label">Repository signals ready to analyze</p>
          <span class="sc-stat-accent" aria-hidden="true"></span>
        </article>

        <article class="sc-stat">
          <p class="sc-stat-value">AI</p>
          <p class="sc-stat-label">Evidence-based career intelligence</p>
          <span class="sc-stat-accent" aria-hidden="true"></span>
        </article>

        <article class="sc-stat">
          <p class="sc-stat-value">24/7</p>
          <p class="sc-stat-label">A clearer path whenever you need it</p>
          <span class="sc-stat-accent" aria-hidden="true"></span>
        </article>
      </section>

      <section id="features" hidden></section>
      <section id="how-it-works" hidden></section>
      <section id="why-skillcompass" hidden></section>

      <div class="sc-container sc-explore">
        <span>Scroll to explore</span>
        <span class="sc-explore-arrow" aria-hidden="true">↓</span>
      </div>
    </main>
  </div>

  <script>
    (() => {
      const menuButton = document.querySelector(".sc-mobile-menu");
      const navLinks = document.querySelector(".sc-nav-links");

      if (!menuButton || !navLinks) return;

      menuButton.addEventListener("click", () => {
        const open = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!open));

        if (!open) {
          navLinks.style.display = "flex";
          navLinks.style.position = "absolute";
          navLinks.style.top = "calc(100% + 10px)";
          navLinks.style.left = "0";
          navLinks.style.right = "0";
          navLinks.style.flexDirection = "column";
          navLinks.style.alignItems = "stretch";
          navLinks.style.padding = "10px";
          navLinks.style.border = "1px solid rgba(112,176,255,0.18)";
          navLinks.style.borderRadius = "18px";
          navLinks.style.background = "rgba(8,25,53,0.96)";
          navLinks.style.boxShadow = "18px 20px 42px rgba(0,0,0,0.28)";
          navLinks.style.backdropFilter = "blur(16px)";
        } else {
          navLinks.removeAttribute("style");
        }
      });
    })();
  </script>
</body>
</html>
